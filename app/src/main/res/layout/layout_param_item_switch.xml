<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/list_item_height"
    android:paddingLeft="@dimen/list_item_padding_left"
    android:paddingRight="@dimen/list_item_padding_right">

    <TextView
        android:id="@+id/tv"
        style="@style/param_setting_txt"
        android:text="@string/soc" />

    <TextView
        android:id="@+id/tvVal"
        style="@style/param_setting_txt"
        android:layout_marginRight="10dp"
        android:text="000"
        android:visibility="gone" />

    <com.huasu.bess4c48.view.SwitchLayout
        android:id="@+id/ivSwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        app:layoutHeight="60"
        app:layoutWidth="120"
        app:textHeight="50"
        app:textWidth="50" />

    <View
        android:id="@+id/view"
        style="@style/divider_1_ECEFF1"
        android:layout_alignParentBottom="true" />
</RelativeLayout>
