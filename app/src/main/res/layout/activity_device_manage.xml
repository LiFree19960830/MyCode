<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@mipmap/page_bg">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <com.lihang.ShadowLayout
        app:hl_cornerRadius="4dp"
        app:hl_shadowColor="@color/hl_shadowColor"
        app:hl_shadowLimit="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="2dp"
        android:layout_below="@+id/rvInfo">

        <RelativeLayout
            android:id="@+id/rlBluetooth"
            android:layout_width="match_parent"
            android:layout_height="@dimen/list_item_height"
            android:paddingLeft="@dimen/list_item_padding_left"
            android:paddingRight="@dimen/list_item_padding_right">

            <ImageView
                android:id="@+id/iv"
                style="@style/param_setting_img"
                android:src="@mipmap/icon_bluetooth" />

            <TextView
                android:id="@+id/tv"
                style="@style/param_setting_txt"
                android:layout_toRightOf="@+id/iv"
                android:text="@string/manage_bluetooth_device_title" />

            <ImageView style="@style/param_setting_arrow" />

        </RelativeLayout>
    </com.lihang.ShadowLayout>

    <LinearLayout
        android:id="@+id/llBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:padding="24dp">

        <Button
            android:id="@+id/btnRead"
            style="@style/blue_line_button"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="@string/read_parameters" />

        <Button
            android:id="@+id/btnRestore"
            style="@style/blue_line_button"
            android:layout_height="32dp"
            android:layout_marginLeft="16dp"
            android:layout_weight="1"
            android:text="@string/restore_parameters" />
    </LinearLayout>
</RelativeLayout>