<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:paddingLeft="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="36dp">
        <EditText
            android:textAlignment="textStart"
            android:enabled="false"
            android:gravity="center"
            android:id="@+id/edDeviceName"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:textColor="#ff455a64"
            android:textSize="13sp"
            android:textColorHint="#B0BEC5"
            android:hint="@string/hint_please_input"
            android:ellipsize="end"
            android:background="@null"/>
        <TextView
            android:visibility="gone"
            android:id="@+id/tvDeviceName"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:textColor="#ff455a64"
            android:textSize="13sp"
            android:textAlignment="textStart"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tvEditBtn"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="@string/edit"
            android:textColor="@color/button_txt_color"
            android:textSize="13sp"
            android:textAlignment="center"
            android:background="@drawable/blue_btn_line_bg"/>
        <TextView
            android:visibility="gone"
            android:gravity="center"
            android:id="@+id/tvSaveBtn"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="@string/save"
            android:textColor="@color/button_txt_color"
            android:textSize="13sp"
            android:textAlignment="center"
            android:background="@drawable/blue_btn_line_bg"/>
        <TextView
            android:layout_marginLeft="5dp"
            android:gravity="center"
            android:id="@+id/tvConnectBtn"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="@string/connect"
            android:textColor="#ffffff"
            android:textSize="13sp"
            android:textAlignment="center"
            android:background="@drawable/blue_btn_bg"/>
        <TextView
            android:layout_marginLeft="5dp"
            android:gravity="center"
            android:id="@+id/tvDeleteBtn"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="@string/delete"
            android:textColor="#ffffff"
            android:textSize="13sp"
            android:textAlignment="center"
            android:background="@drawable/blue_btn_bg"/>
    </LinearLayout>
    <View
        android:layout_marginTop="2dp"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#ECEFF1"/>
</LinearLayout>