<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/icon_bg"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    android:paddingLeft="15dp"
    android:paddingRight="15dp"
    android:paddingBottom="50dp">

    <ImageView
        android:id="@+id/ivClose"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:padding="10dp"
        android:layout_marginTop="10dp"
        android:layout_gravity="right"
        android:background="@mipmap/icon_close"
        android:visibility="gone"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="50dp">

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv1"
                style="@style/download_img" />

            <TextView
                android:id="@+id/tv1"
                style="@style/download_txt"
                android:layout_below="@+id/iv1"
                android:text="@string/status_read_start" />
        </RelativeLayout>

        <View
            android:id="@+id/view1"
            style="@style/download_divider" />

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv2"
                style="@style/download_img" />

            <TextView
                android:id="@+id/tv2"
                style="@style/download_txt"
                android:layout_below="@+id/iv2"
                android:text="@string/status_read_complete" />
        </RelativeLayout>

        <View
            android:id="@+id/view2"
            style="@style/download_divider" />

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv3"
                style="@style/download_img" />

            <TextView
                android:id="@+id/tv3"
                style="@style/download_txt"
                android:layout_below="@+id/iv3"
                android:text="@string/status_export_start" />
        </RelativeLayout>

        <View
            android:id="@+id/view3"
            style="@style/download_divider" />

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv4"
                style="@style/download_img" />

            <TextView
                android:id="@+id/tv4"
                style="@style/download_txt"
                android:layout_below="@+id/iv4"
                android:text="@string/status_export_complete" />
        </RelativeLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/tvFile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#455A64"
        android:layout_marginTop="10dp"
        android:gravity="center_horizontal"
        android:textSize="14sp"/>
</LinearLayout>
