<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@mipmap/page_bg"
    android:orientation="vertical">

    <com.lihang.ShadowLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="2dp"
        app:hl_cornerRadius="4dp"
        app:hl_shadowColor="@color/hl_shadowColor"
        app:hl_shadowLimit="5dp">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.huasu.bess4c48.view.Tab
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:tab_text="@string/setting_data_export" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="6dp"
                android:layout_marginRight="15dp"
                android:layout_marginBottom="28dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvSearchCount"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:background="@drawable/input_bg"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:hint="@string/select_export_count"
                    android:paddingLeft="10dp"
                    android:textColor="#ff455a64"
                    android:textColorHint="#B0BEC5"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnExport"
                    style="@style/blue_button"
                    android:layout_marginLeft="12dp"
                    android:text="@string/btn_export_record" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvFile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:gravity="center_horizontal"
                android:textColor="#455A64"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </com.lihang.ShadowLayout>
</LinearLayout>