<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">


        <!-- 当前连接的设备 -->
        <com.lihang.ShadowLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="2dp"
            app:hl_cornerRadius="4dp"
            app:hl_shadowColor="@color/hl_shadowColor"
            app:hl_shadowLimit="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="12dp"
                android:paddingRight="12dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@mipmap/ic_lanya" />

                <TextView
                    android:id="@+id/tvCurrentDeviceName"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp"
                    android:layout_weight="1"
                    android:background="#eef3fd"
                    android:gravity="center"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:text="--"
                    android:textAlignment="textStart"
                    android:textColor="#4d48575e"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvDisconnectBtn"
                    android:layout_width="70dp"
                    android:layout_height="28dp"
                    android:background="@drawable/blue_btn_bg"
                    android:gravity="center"
                    android:text="@string/disconnect"
                    android:textAlignment="center"
                    android:textColor="#ffffff"
                    android:visibility="gone" />
            </LinearLayout>

        </com.lihang.ShadowLayout>

        <!-- 已连接过的设备 -->
        <com.lihang.ShadowLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="2dp"
            app:hl_cornerRadius="4dp"
            app:hl_shadowColor="@color/hl_shadowColor"
            app:hl_shadowLimit="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">
                <!--标题-->
                <com.huasu.bess4c48.view.Tab
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    app:tab_text="@string/history_connected_device" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvHistoryDevice"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:overScrollMode="never"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:scrollbars="none"
                    android:visibility="gone" />

                <com.huasu.bess4c48.view.TableNoData
                    android:id="@+id/tableNoDataHistoryDevice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp" />
            </LinearLayout>
        </com.lihang.ShadowLayout>

        <!-- 扫描到的蓝牙设备 -->
        <com.lihang.ShadowLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="2dp"
            app:hl_cornerRadius="4dp"
            app:hl_shadowColor="@color/hl_shadowColor"
            app:hl_shadowLimit="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">
                <!--标题-->
                <com.huasu.bess4c48.view.Tab
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    app:tab_text="@string/bluetooth_device" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvBleScanList"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:overScrollMode="never"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:scrollbars="none"
                    android:visibility="gone" />

                <com.huasu.bess4c48.view.TableNoData
                    android:id="@+id/tableNoDataBleScanList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp" />
            </LinearLayout>
        </com.lihang.ShadowLayout>

        <!-- 扫描按钮 -->
        <com.lihang.ShadowLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            app:hl_cornerRadius="2dp"
            app:hl_shadowColor="@color/hl_shadowColor"
            app:hl_shadowLimit="5dp">

            <TextView
                android:id="@+id/tvScanBtn"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:background="@drawable/blue_btn_bg"
                android:gravity="center"
                android:text="@string/scan_bluetooth_device"
                android:textColor="#ffffff"
                android:textSize="14sp" />
        </com.lihang.ShadowLayout>
    </LinearLayout>
</ScrollView>